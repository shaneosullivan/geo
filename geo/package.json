{
  "name": "@chofter/geo",
  "version": "0.1.0",
  "description": "Tiny, dependency-free town and city search over static GeoNames files. No API, no key.",
  "keywords": ["geonames", "geocoding", "places", "cities", "towns", "autocomplete", "search"],
  "homepage": "https://geo.chofter.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaneosullivan/geo.git"
  },
  "bugs": "https://github.com/shaneosullivan/geo/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/geo.d.ts",
      "default": "./dist/geo.js"
    },
    "./global": "./dist/geo.global.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/geo.d.ts",
  "unpkg": "./dist/geo.global.js",
  "jsdelivr": "./dist/geo.global.js",
  "files": ["dist"],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  }
}
