{
  "name": "@chofter/geo",
  "version": "0.3.0",
  "description": "Tiny, dependency-free town and city search over static GeoNames files. No API, no key.",
  "keywords": [
    "geonames",
    "geocoding",
    "places",
    "cities",
    "towns",
    "autocomplete",
    "search"
  ],
  "homepage": "https://github.com/shaneosullivan/geo/tree/main/js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaneosullivan/geo.git",
    "directory": "js"
  },
  "bugs": "https://github.com/shaneosullivan/geo/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/geo.d.ts",
      "default": "./dist/geo.js"
    },
    "./min": {
      "types": "./dist/geo.d.ts",
      "default": "./dist/geo.min.js"
    },
    "./global": "./dist/geo.global.js",
    "./global.min": "./dist/geo.global.min.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/geo.d.ts",
  "unpkg": "./dist/geo.global.min.js",
  "jsdelivr": "./dist/geo.global.min.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build.mjs",
    "test": "bun build.mjs && node --test",
    "lint": "oxlint -c ../.oxlintrc.json .",
    "format": "oxfmt -c ../.oxfmtrc.json .",
    "format:check": "oxfmt --check -c ../.oxfmtrc.json .",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "oxlint": "^1.94.0",
    "oxfmt": "^0.79.0"
  }
}
